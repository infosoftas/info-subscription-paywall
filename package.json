{
  "name": "@infosoftas/info-subscription-paywall",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone browser subscriber paywall SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infosoftas/info-subscription-paywall.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "vite build --mode npm",
    "build:browser": "vite build --mode browser",
    "build": "npm run typecheck && npm run build:types && npm run build:esm && npm run build:browser && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "5.25.0"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
